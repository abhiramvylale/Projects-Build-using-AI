<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:padding="16dp">

    <!-- Status Bar -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🚢 Boat Controller"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/statusIndicator"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/status_indicator_disconnected" />

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disconnected"
            android:textColor="@color/status_disconnected"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Connection Mode Toggle -->
    <LinearLayout
        android:id="@+id/connectionModeLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toBottomOf="@id/statusBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanConnect"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scan &amp; Connect"
            android:textColor="@color/accent"
            app:strokeColor="@color/accent"
            app:iconTint="@color/accent"
            app:icon="@android:drawable/stat_sys_data_bluetooth" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleMode"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Mode: Classic"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <!-- Data Monitor Window -->
    <TextView
        android:id="@+id/tvMonitorLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="📡 Incoming Data Monitor"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/connectionModeLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/monitorScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/monitor_bg"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvMonitorLabel"
        app:layout_constraintBottom_toTopOf="@id/tvControlsLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvMonitor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Waiting for connection...\n"
            android:textColor="@color/monitor_text"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp" />
    </ScrollView>

    <!-- Controls Label -->
    <TextView
        android:id="@+id/tvControlsLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="🎮 Controls"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/btnForward"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Forward Button (centered, above the left/right row) -->
    <Button
        android:id="@+id/btnForward"
        android:layout_width="120dp"
        android:layout_height="70dp"
        android:text="▲\nFORWARD"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/rounded_button"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toTopOf="@id/btnLeft"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp" />

    <!-- Middle Row: Left, Up, Right -->
    <Button
        android:id="@+id/btnLeft"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:text="◀\nLEFT"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/rounded_button_left"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toTopOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnUp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnUp"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:text="⬆\nUP"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/rounded_button_up"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toTopOf="@id/btnBack"
        app:layout_constraintStart_toEndOf="@id/btnLeft"
        app:layout_constraintEnd_toStartOf="@id/btnRight"
        android:layout_marginHorizontal="6dp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnRight"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:text="▶\nRIGHT"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/rounded_button_right"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toTopOf="@id/btnBack"
        app:layout_constraintStart_toEndOf="@id/btnUp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="6dp"
        android:layout_marginBottom="8dp" />

    <!-- Back Button (centered, below the middle row) -->
    <Button
        android:id="@+id/btnBack"
        android:layout_width="120dp"
        android:layout_height="70dp"
        android:text="▼\nBACK"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/rounded_button_back"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
